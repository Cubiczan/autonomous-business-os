ENVIRONMENT=development
APP_NAME=Autonomous Business Operating System
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./storage/business_os.sqlite3
REDIS_URL=redis://redis:6379/0
# SECURITY WARNING: Both keys below MUST be replaced with strong random values
# before any non-local deployment.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme-insecure-default-do-not-use-in-prod
ADMIN_API_KEY=changeme-insecure-default-do-not-use-in-prod
LOG_LEVEL=INFO

# CockroachDB — set USE_COCKROACHDB=true to enable distributed backend
# When enabled, ABOS_DATABASE_URL is used instead of DATABASE_URL
USE_COCKROACHDB=false
# ABOS_DATABASE_URL=cockroachdb+psycopg2://user:pass@host:26257/autonomous_business_os?sslmode=require

# Webhook verification
SLACK_SIGNING_SECRET=
STRIPE_WEBHOOK_SECRET=
DOCUSIGN_WEBHOOK_SECRET=
UIPATH_WEBHOOK_SECRET=

# Lead qualification
APOLLO_API_KEY=
HUNTER_API_KEY=
HUBSPOT_ACCESS_TOKEN=
SALESFORCE_ACCESS_TOKEN=
CRM_PROVIDER=hubspot

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# Onboarding and delivery
DOCUSIGN_ACCESS_TOKEN=
NOTION_TOKEN=
NOTION_DATABASE_ID=
LINEAR_API_KEY=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=
CALENDAR_PROVIDER=google
GOOGLE_CALENDAR_CREDENTIALS_JSON=
MICROSOFT_GRAPH_TOKEN=

# Finance
STRIPE_API_KEY=
ACCOUNTING_PROVIDER=quickbooks
QUICKBOOKS_ACCESS_TOKEN=
XERO_ACCESS_TOKEN=

# Airbyte Agents (hosted SDK mode — credentials for third-party services live in app.airbyte.ai)
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_WORKSPACE_NAME=default
AIRBYTE_ORGANIZATION_ID=

# Task management defaults for Airbyte SDK create actions
LINEAR_TEAM_ID=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
ABOS_LEDGER_SIGNING_KEY=

# LlamaIndex Cloud / LlamaCloud
LLAMA_CLOUD_API_KEY=
LLAMA_CLOUD_KNOWLEDGE_PIPELINE_ID=
LLAMA_CLOUD_DENSE_TOP_K=12
LLAMA_CLOUD_SPARSE_TOP_K=12
LLAMA_CLOUD_RERANK_TOP_N=5
